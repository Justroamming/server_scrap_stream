# =============================================================
# STREAMING BACKEND - CẤU HÌNH MÔI TRƯỜNG
# Bước 1: Copy file này thành .env
#          cp .env.example .env
# Bước 2: Điền các giá trị thực tế vào
# =============================================================

# ---- [QUAN TRỌNG] IP/Hostname của máy đang chạy server này ----
# Pi và App sẽ dùng địa chỉ này để kết nối vào.
# - Khi dev cùng mạng LAN: điền IP LAN của máy bạn (vd: 192.168.1.100)
#   Lấy IP LAN: Windows → ipconfig | Mac/Linux → ifconfig
# - Khi dùng ngrok: điền domain ngrok (vd: 0.tcp.ngrok.io:12345)
# - Khi deploy lên server thật: điền domain (vd: stream.reclick.vn)
SERVER_HOST=192.168.1.100

# Port server lắng nghe
PORT=8100

# MySQL — same database the Spring Boot backend uses (read access is enough)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pos_db
DB_USER=streaming_reader
DB_PASSWORD=change_me

# Spring Boot validates viewer JWT/session, role, account, yard and device.
BACKEND_BASE_URL=http://127.0.0.1:8080
BACKEND_REQUEST_TIMEOUT_MS=3000

# ---- Dành cho fake_pi.js (giả lập Pi khi chưa có phần cứng) ----
# Lấy device_id sau khi chạy lệnh SQL thêm device vào DB
DEVICE_ID=1
# Raw key được Backend trả đúng một lần khi tạo/rotate device.
DEVICE_KEY=
